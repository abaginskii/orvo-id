# Адрес сайта orvo ID (без / в конце)
PUBLIC_URL=https://orvo-id.vercel.app
# Случайная строка от 32 символов: подписывает cookie входа
ORVO_SECRET=
# Бот из @BotFather (npm run setup-bot впишет их сам)
BOT_TOKEN=
BOT_USERNAME=
TG_WEBHOOK_SECRET=
# Проекты, которые входят через orvo ID
ORVO_CLIENTS=[{"id":"polka","secret":"…","redirects":["https://study-shelf-three.vercel.app/api/auth/orvo/callback"]}]
# Только локально: кнопка «Подтвердить без Telegram»
ORVO_DEV_LOGIN=1
